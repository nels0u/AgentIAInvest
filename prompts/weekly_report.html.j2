<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Synthèse hebdomadaire des marchés</title>
<style>
:root{--n:#142b57;--b:#2f5ca8;--t:#344b73;--l:#d9e2f2;--bg:#eef3fb;--u:#128245;--d:#c73535;--s:0 16px 34px rgba(15,42,85,.10)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:radial-gradient(circle at 0 0,#f8fbff,transparent 36%),linear-gradient(180deg,#f9fbff,var(--bg));padding:24px;color:var(--t)}
.sheet{max-width:1400px;margin:auto;background:#fff;border:1px solid var(--l);border-radius:18px;overflow:hidden;box-shadow:var(--s)}
.header{padding:24px 30px;border-bottom:1px solid #e6edf8;background:linear-gradient(180deg,#fff,#f8fbff);display:grid;grid-template-columns:1fr 270px;gap:12px;align-items:end}
h1{margin:0;font-size:clamp(34px,3.2vw,54px);color:var(--n)}.sub{margin-top:8px;font-size:18px}.period{text-align:right;font-size:14px}.period strong{display:block;font-size:22px;color:var(--n)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px}.panel{border:1px solid var(--l);border-radius:12px;overflow:hidden;background:#fff}.ph{padding:12px 16px;background:linear-gradient(90deg,var(--n),var(--b));color:#f7e4b1;font-size:20px;font-weight:700}
.split{display:grid;grid-template-columns:1fr 1fr}.col{padding:14px}.col+.col{border-left:1px solid #e8eef9}.col h3{margin:0 0 10px;color:var(--n);font-size:17px;text-transform:uppercase}
table{width:100%;border-collapse:collapse}tr{border-bottom:1px solid #edf2fb}tr:last-child{border-bottom:0}td{padding:7px 0;font-size:15px}td:last-child{text-align:right;font-weight:700}.up{color:var(--u)}.down{color:var(--d)}
.asset{color:inherit;text-decoration:none;border-bottom:1px dashed #9fb2d4}.asset:hover{color:var(--b)}
.etf{display:inline-grid;place-items:center;width:18px;height:18px;border-radius:4px;background:linear-gradient(180deg,#f5f9ff,#e9f0fe);border:1px solid #d6e1f7;color:#2f5ca8;font-size:11px;margin-right:6px}
.cards{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;padding:0 14px 14px}.card{border:1px solid var(--l);border-radius:12px;padding:14px;background:linear-gradient(180deg,#fff,#fcfdff);min-height:328px}.card h3{margin:0 0 10px;color:var(--n);font-size:22px;border-bottom:2px solid #ebd9ad;padding-bottom:6px}.card p{margin:0 0 10px;line-height:1.46}
.src{font-size:13px;color:#5f7397;text-decoration:none;border-bottom:1px solid rgba(95,115,151,.5)}.src:hover{color:var(--b)}
.takeaway{margin:0 14px 14px;border:1px solid var(--l);border-radius:12px;padding:14px 16px;background:linear-gradient(90deg,#fffef8,#fff);font-size:18px;font-weight:640}
@media(max-width:1120px){.header{grid-template-columns:1fr}.period{text-align:left}.grid,.cards,.split{grid-template-columns:1fr}.col+.col{border-left:0;border-top:1px solid #e8eef9}}
</style></head>
<body><main class="sheet"><section class="header"><div><h1>Synthèse hebdomadaire des marchés</h1><div class="sub">Période analysée du {{ report.period_start.strftime('%d/%m/%Y') }} au {{ report.period_end.strftime('%d/%m/%Y') }}</div></div><div class="period"><strong>Lecture de la semaine</strong>Rapport généré le {{ report.generated_at.strftime('%d/%m/%Y') }}</div></section>
<section class="grid"><article class="panel"><div class="ph">Évolution du marché sur 7 jours</div><div class="split"><div class="col"><h3>Principaux indices</h3><table>{% for item in report.market_moves %}<tr><td><a class="asset" href="{{ item.source_url }}" target="_blank">{{ item.name }}</a></td><td class="{{ 'up' if item.period_return_pct>=0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>{% endfor %}</table></div><div class="col"><h3>ETF & segments remarquables</h3><table>{% for item in report.remarkable_moves %}<tr><td><span class="etf">◉</span><a class="asset" href="{{ item.source_url }}" target="_blank">{{ item.name }}</a></td><td class="{{ 'up' if item.period_return_pct>=0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>{% endfor %}</table></div></div></article>
<article class="panel"><div class="ph">Évolution du marché sur 3 mois</div><div class="split"><div class="col"><h3>Principaux indices</h3><table>{% for item in report.quarterly_market_moves %}<tr><td><a class="asset" href="{{ item.source_url }}" target="_blank">{{ item.name }}</a></td><td class="{{ 'up' if item.period_return_pct>=0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>{% endfor %}</table></div><div class="col"><h3>ETF & segments remarquables</h3><table>{% for item in report.quarterly_remarkable_moves %}<tr><td><span class="etf">◉</span><a class="asset" href="{{ item.source_url }}" target="_blank">{{ item.name }}</a></td><td class="{{ 'up' if item.period_return_pct>=0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>{% endfor %}</table></div></div></article></section>
<section class="cards">
<article class="card"><h3>🌍 Géopolitique</h3>{% for p in report.geopolitical_narrative %}<p>{{ p.text|safe }} <a class="src" href="{{ p.source.url }}" target="_blank">{{ p.source.label }}</a></p>{% endfor %}</article>
<article class="card"><h3>📰 Business actu</h3>{% for p in report.business_narrative %}<p>{{ p.text|safe }} <a class="src" href="{{ p.source.url }}" target="_blank">{{ p.source.label }}</a></p>{% endfor %}</article>
<article class="card"><h3>⚠️ Points d'attention</h3>{% for p in report.risk_narrative %}<p>{{ p.text|safe }} <a class="src" href="{{ p.source.url }}" target="_blank">{{ p.source.label }}</a></p>{% endfor %}</article>
</section>
<section class="takeaway">💡 À retenir : {{ report.key_takeaway }}</section></main></body></html>
