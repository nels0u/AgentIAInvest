<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Synthèse hebdomadaire des marchés</title>
  <style>
    :root {
      --navy-900: #0f234c;
      --navy-700: #21427f;
      --slate-900: #1d2a44;
      --slate-700: #425577;
      --slate-500: #7082a1;
      --line: #d8dfec;
      --bg: #eef2f8;
      --surface: #ffffff;
      --surface-soft: #f8faff;
      --positive: #1f8a4c;
      --negative: #c63a3a;
      --accent: #caa24f;
      --shadow: 0 14px 32px rgba(16, 37, 82, 0.08);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Inter", "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at 12% -8%, rgba(34, 66, 127, 0.16), transparent 36%),
        radial-gradient(circle at 100% 0%, rgba(202, 162, 79, 0.10), transparent 28%),
        linear-gradient(180deg, #f8fafe 0%, var(--bg) 100%);
      color: var(--slate-900);
      padding: 26px;
    }
    .sheet {
      max-width: 1360px;
      margin: 0 auto;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
      overflow: hidden;
      box-shadow: var(--shadow);
    }
    .header {
      padding: 24px 28px 18px;
      border-bottom: 1px solid #e5eaf5;
      background:
        linear-gradient(180deg, rgba(255,255,255,.97), rgba(249,251,255,.97)),
        repeating-linear-gradient(45deg, rgba(26,58,122,0.03) 0, rgba(26,58,122,0.03) 9px, transparent 9px, transparent 18px);
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 12px;
      align-items: end;
    }
    .header h1 { margin: 0; font-size: clamp(32px, 3.2vw, 54px); color: var(--navy-900); letter-spacing: .3px; }
    .header p { margin: 8px 0 0; color: var(--slate-700); font-size: 18px; }
    .period { text-align: right; color: var(--slate-700); font-size: 14px; line-height: 1.45; }
    .period strong { display: block; font-size: 23px; color: var(--navy-900); }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 14px; }
    .panel { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
    .panel-head { padding: 11px 15px; background: linear-gradient(90deg, var(--navy-900), var(--navy-700)); color: #f7e4b1; font-size: 20px; font-weight: 700; }
    .panel-body-split { display: grid; grid-template-columns: 1fr 1fr; }
    .col { padding: 14px; }
    .col + .col { border-left: 1px solid #e7ecf8; }
    .col h3 { margin: 0 0 10px; font-size: 17px; color: var(--navy-900); text-transform: uppercase; }

    table { width: 100%; border-collapse: collapse; }
    tr { border-bottom: 1px solid #edf1f9; }
    tr:last-child { border-bottom: 0; }
    td { padding: 7px 0; font-size: 15px; color: var(--slate-700); }
    td:last-child { text-align: right; font-weight: 700; }
    .up { color: var(--positive); }
    .down { color: var(--negative); }

    .pill { font-size: 12px; border: 1px solid #d9e1f2; color: var(--slate-500); border-radius: 999px; padding: 3px 8px; background: #f7faff; }

    .icons-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 14px 12px; }
    .icon-chip { display: inline-flex; gap: 7px; align-items: center; font-size: 13px; color: var(--slate-700); background: var(--surface-soft); border: 1px solid #e1e8f7; border-radius: 999px; padding: 6px 10px; }

    .insights { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; padding: 0 14px 14px; }
    .card { border: 1px solid var(--line); border-radius: 12px; padding: 14px; background:
      linear-gradient(180deg, #fff, #fcfdff),
      repeating-linear-gradient(0deg, rgba(29,57,112,0.02), rgba(29,57,112,0.02) 11px, transparent 11px, transparent 22px);
      min-height: 320px;
    }
    .card h3 { margin: 0 0 10px; color: var(--navy-900); font-size: 22px; border-bottom: 2px solid #ecd8aa; padding-bottom: 6px; }
    .card p { margin: 0 0 10px; font-size: 15px; color: var(--slate-700); line-height: 1.45; }

    .sources { margin-top: 10px; padding-top: 10px; border-top: 1px dashed #dfe6f6; display: flex; flex-wrap: wrap; gap: 9px; }
    .sources a { color: var(--navy-700); font-size: 13px; text-decoration: none; border-bottom: 1px solid rgba(33,66,127,.35); }
    .sources a:hover { color: var(--navy-900); }

    .takeaway { margin: 0 14px 14px; border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(90deg, #fffef8 0%, #ffffff 100%); padding: 14px 16px; font-size: 18px; font-weight: 640; }

    @media (max-width: 1120px) {
      .header { grid-template-columns: 1fr; }
      .period { text-align: left; }
      .grid-2, .insights { grid-template-columns: 1fr; }
      .panel-body-split { grid-template-columns: 1fr; }
      .col + .col { border-left: 0; border-top: 1px solid #e7ecf8; }
    }
  </style>
</head>
<body>
  <main class="sheet">
    <section class="header">
      <div>
        <h1>Synthèse hebdomadaire des marchés</h1>
        <p>Période analysée du {{ report.period_start.strftime('%d/%m/%Y') }} au {{ report.period_end.strftime('%d/%m/%Y') }}</p>
      </div>
      <div class="period">
        <strong>Lecture de la semaine</strong>
        Rapport généré le {{ report.generated_at.strftime('%d/%m/%Y') }}
      </div>
    </section>

    <div class="icons-row">
      <span class="icon-chip">📊 Indices</span>
      <span class="icon-chip">🏦 Banques centrales</span>
      <span class="icon-chip">🛢️ Énergie</span>
      <span class="icon-chip">🧠 ETF thématiques</span>
      <span class="icon-chip">🌍 Géopolitique</span>
    </div>

    <section class="grid-2">
      <article class="panel">
        <div class="panel-head">Évolution du marché sur 7 jours</div>
        <div class="panel-body-split">
          <div class="col">
            <h3>Principaux indices <span class="pill">hebdomadaire</span></h3>
            <table>
              {% for item in report.market_moves %}
              <tr><td>{{ item.name }}</td><td class="{{ 'up' if item.period_return_pct >= 0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>
              {% endfor %}
            </table>
          </div>
          <div class="col">
            <h3>ETF & segments remarquables <span class="pill">hebdomadaire</span></h3>
            <table>
              {% for item in report.remarkable_moves %}
              <tr><td>🧩 {{ item.name }}</td><td class="{{ 'up' if item.period_return_pct >= 0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>
              {% endfor %}
            </table>
          </div>
        </div>
        <div class="sources">
          <a href="https://www.spglobal.com/spdji/en/indices/equity/sp-500/" target="_blank">S&P Dow Jones</a>
          <a href="https://www.nasdaq.com/market-activity/index/ndx" target="_blank">Nasdaq</a>
          <a href="https://www.msci.com/our-solutions/indexes" target="_blank">MSCI</a>
          <a href="https://www.ice.com/products/219/Brent-Crude-Futures" target="_blank">ICE Brent</a>
        </div>
      </article>

      <article class="panel">
        <div class="panel-head">Évolution du marché sur 3 mois</div>
        <div class="col" style="padding-top: 12px;">
          <h3>Lecture trimestrielle consolidée <span class="pill">3 mois</span></h3>
          <table>
            {% for item in report.quarterly_market_moves %}
            <tr><td>{{ item.name }}</td><td class="{{ 'up' if item.period_return_pct >= 0 else 'down' }}">{{ '%+.1f'|format(item.period_return_pct) }} %</td></tr>
            {% endfor %}
          </table>
          <p style="margin: 12px 0 0; color: var(--slate-700); font-size: 15px; line-height: 1.45;">
            Sur trois mois la dynamique reste <strong>favorable aux actifs de croissance</strong> avec un soutien des bénéfices.
            La hausse de l'énergie et la sensibilité aux taux imposent néanmoins une construction de portefeuille plus équilibrée.
          </p>
        </div>
        <div class="sources" style="margin: 0 14px 12px;">
          <a href="https://fred.stlouisfed.org/" target="_blank">FRED</a>
          <a href="https://data-api.ecb.europa.eu/" target="_blank">ECB Data Portal</a>
          <a href="https://www.reuters.com/world/" target="_blank">Reuters World</a>
          <a href="https://www.imf.org/en/Data" target="_blank">IMF Data</a>
        </div>
      </article>
    </section>

    <section class="insights">
      <article class="card">
        <h3>🌍 Géopolitique</h3>
        {% for p in report.geopolitical_narrative %}
        <p>{{ p }}</p>
        {% endfor %}
        <div class="sources">
          <a href="https://www.reuters.com/world/" target="_blank">Reuters</a>
          <a href="https://www.consilium.europa.eu/en/" target="_blank">EU Council</a>
          <a href="https://www.iea.org/" target="_blank">IEA</a>
        </div>
      </article>

      <article class="card">
        <h3>📰 Business actu</h3>
        {% for p in report.business_narrative %}
        <p>{{ p }}</p>
        {% endfor %}
        <div class="sources">
          <a href="https://www.sec.gov/edgar/search/" target="_blank">SEC EDGAR</a>
          <a href="https://www.lseg.com/en/data-analytics" target="_blank">LSEG</a>
          <a href="https://www.reuters.com/markets/" target="_blank">Reuters Markets</a>
        </div>
      </article>

      <article class="card">
        <h3>⚠️ Points d'attention</h3>
        {% for p in report.risk_narrative %}
        <p>{{ p }}</p>
        {% endfor %}
        <div class="sources">
          <a href="https://www.federalreserve.gov/" target="_blank">Federal Reserve</a>
          <a href="https://www.bls.gov/" target="_blank">BLS</a>
          <a href="https://www.ecb.europa.eu/press/govcdec/mopo/html/index.en.html" target="_blank">ECB</a>
        </div>
      </article>
    </section>

    <section class="takeaway">💡 À retenir : {{ report.key_takeaway }}</section>
  </main>
</body>
</html>
